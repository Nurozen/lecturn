      "./renderer": {
        "types": "./dist/renderer.d.mts",
        "default": "./dist/renderer.mjs"
      },
      "./browser": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "./electron-preload": "./dist/electron-preload.cjs"
    }
