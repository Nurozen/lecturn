    <binary>lecturn</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://lecturn.cloudgatherer.net</url>
  <url type="bugtracker">https://github.com/Nurozen/lecturn/issues</url>
  <url type="vcs-browser">https://github.com/Nurozen/lecturn</url>
