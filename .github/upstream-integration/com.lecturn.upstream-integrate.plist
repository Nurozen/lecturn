<?xml version="1.0" encoding="UTF-8"?>
<!-- Template only. Install after a verified caught-up run. Substitute absolute
     paths; __PATH__ must contain the authorized Node, Codex, gh and Stave CLIs.
     Preserve __STATE__ across runs. No bootstrap SHA belongs in the schedule:
     progress.json must already contain verified accepted ancestry. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lecturn.upstream-integrate</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/.github/upstream-integration/run-batches.py</string>
    <string>--repo</string><string>__REPO__</string>
    <string>--state-dir</string><string>__STATE__</string>
    <string>--spaces-dir</string><string>__SPACES__</string>
    <string>--refresh-mirror</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__PATH__</string></dict>
  <key>StartInterval</key><integer>10800</integer>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__LOGS__/lecturn-upstream-integrate.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/lecturn-upstream-integrate.log</string>
</dict>
</plist>
